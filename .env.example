# =============================================================
# TechFlow — پیکربندی مرکزی
# کپی کنید و ویرایش کنید:  cp .env.example .env
#
# این فایل هم توسط `docker compose` (حالت B) و هم توسط بک‌اند در
# حالت توسعه‌ی لوکال (حالت A) خوانده می‌شود.
# =============================================================

# --- امنیتی ----------------------------------------------------
# در production حتماً عوض شود. تولید:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
TECHFLOW_SECRET_KEY=dev-insecure-secret-key-change-me

# 1 = حالت debug (فقط برای توسعه‌ی لوکال؛ روی سرور بگذارید 0)
TECHFLOW_DEBUG=0

# میزبان‌های مجاز Django (با ویرگول). برای سرور دامنه‌ی خود را بگذارید:
# مثال: TECHFLOW_ALLOWED_HOSTS=techflow.example.com,10.0.0.5
TECHFLOW_ALLOWED_HOSTS=localhost,127.0.0.1

# Originهای معتبر CSRF اضافه (با ویرگول). برای هر آدرس/دامنه‌ای که
# از آن به UI دسترسی دارید. (Originهای توسعه‌ی Vite به‌طور خودکار
# اضافه می‌شوند.)
# مثال: TECHFLOW_CSRF_TRUSTED_ORIGINS=https://techflow.example.com
TECHFLOW_CSRF_TRUSTED_ORIGINS=

# --- ادمین پیش‌فرض ---------------------------------------------
# در اولین راه‌اندازی (بعد از migrate) به‌صورت خودکار ساخته می‌شود.
# سازمان و تیم پیش‌فرض هم در همین مرحله ساخته می‌شوند.
TECHFLOW_ADMIN_USERNAME=admin
# اگر خالی باشد، رمز قوی تولید شده و یک‌بار در لاگ چاپ می‌شود:
#   docker compose logs backend | grep Password
TECHFLOW_ADMIN_PASSWORD=

# --- دیتای نمایشی (demo) ----------------------------------------
# 0 = دیتابیس خالی شروع می‌شود (پیش‌فرض؛ مناسب سرور)
# 1 = اگر دیتابیس خالی بود، دیتای نمایشی seed_demo بارگذاری شود
TECHFLOW_SEED_DEMO=0

# --- دیتابیس (Postgres) -------------------------------------------
# در Docker Compose، کانتینر db این مقادیر را استفاده می‌کند و بک‌اند
# به‌صورت داخلی از هاست "db" وصل می‌شود (خودکار).
# در حالت توسعه‌ی لوکال (حالت A)، بک‌اند همین مقادیر را با این
# HOST/PORT به PostgreSQL محلی وصل می‌کند.
TECHFLOW_DB_HOST=localhost
TECHFLOW_DB_PORT=5432
TECHFLOW_DB_USER=techflow
TECHFLOW_DB_PASSWORD=techflow
TECHFLOW_DB_NAME=techflow

# --- پورت‌های منتشرشده روی هاست (Docker) -------------------------
# اگر پورت 5433 با PostgreSQL محلی تداخل دارد، تغییر دهید.
TECHFLOW_DB_PORT_HOST=5433
TECHFLOW_BACKEND_PORT=8000
TECHFLOW_FRONTEND_PORT=5173
# Adminer (رابط وب دیتابیس) — http://<server-ip>:8080
TECHFLOW_ADMINER_PORT=8080
